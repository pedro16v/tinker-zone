{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinker.zone/patch-schema.json",
  "title": "tinker.zone live patch",
  "description": "Reference schema for live-layer patches. The AUTHORITATIVE validator is widget/patch-validator.js, which adds semantic checks this schema cannot express (color/length parsing, image-host allowlist, palette membership, never-target-the-widget). Kept in sync with widget/patch-vocab.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "ops"],
  "properties": {
    "v": { "const": 1 },
    "ops": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/op" } }
  },
  "$defs": {
    "safeSelector": { "type": "string", "pattern": "^[.#]?[A-Za-z][\\w-]{0,63}$" },
    "op": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["op", "name", "value"],
          "properties": {
            "op": { "const": "set_css_var" },
            "name": { "enum": ["--tz-bg", "--tz-fg", "--tz-accent", "--tz-font", "--tz-radius", "--tz-space"] },
            "value": { "type": "string", "maxLength": 200 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "target", "value"],
          "properties": {
            "op": { "const": "set_text" },
            "target": { "$ref": "#/$defs/safeSelector" },
            "value": { "type": "string", "maxLength": 280 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "theme"],
          "properties": {
            "op": { "const": "set_theme" },
            "theme": { "enum": ["light", "dark", "sunset", "terminal", "pastel"] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "kind", "container"],
          "properties": {
            "op": { "const": "add_element" },
            "kind": { "enum": ["heading", "paragraph", "button-noop", "divider", "emoji-badge"] },
            "container": { "$ref": "#/$defs/safeSelector" },
            "text": { "type": "string", "maxLength": 280 },
            "class": { "enum": ["tz-card", "tz-hero", "tz-muted", "tz-pill"] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "target", "attr", "value"],
          "properties": {
            "op": { "const": "set_attr" },
            "target": { "$ref": "#/$defs/safeSelector" },
            "attr": { "enum": ["class", "alt", "aria-label", "title"] },
            "value": { "type": "string", "maxLength": 120 }
          }
        }
      ]
    }
  }
}
